# Backend environment. Copy to backend/.env and fill in real values.
#   cp backend/.env.example backend/.env
# NEVER commit a completed .env.

# --- Database -----------------------------------------------------------
# `postgres://` and `postgresql://` are both accepted and normalised to the
# psycopg 3 driver automatically, so a managed provider's URL can be pasted
# in unchanged.
DATABASE_URL=postgresql+psycopg://shridev:CHANGE_ME@127.0.0.1:5432/shridev

# Used only by the test suite (pytest drops and recreates its schema).
TEST_DATABASE_URL=postgresql+psycopg://shridev:CHANGE_ME@127.0.0.1:5432/shridev_test

# --- Security -----------------------------------------------------------
# Signs admin access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED when ENVIRONMENT=production — the app refuses to start without it.
# Changing it immediately invalidates every issued token.
SECRET_KEY=

# development | staging | production
# In production the app also refuses a localhost DATABASE_URL or CORS origin,
# and disables /docs, /redoc and /openapi.json.
ENVIRONMENT=development
DEBUG=false

ACCESS_TOKEN_EXPIRE_MINUTES=480
# bcrypt work factor. Each +1 doubles hashing cost; raise as hardware improves.
BCRYPT_ROUNDS=12

# --- CORS ---------------------------------------------------------------
# Exact origins only, comma separated. Never "*": admin requests carry
# credentials, and a wildcard would make them readable from any site.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting ------------------------------------------------------
# Counters live in the worker process, so with several workers the effective
# limit is per process. See docs/deployment.md before scaling horizontally.
RATE_LIMIT_ENABLED=true
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=900

# --- First admin account (read only by scripts/create_admin.py) ---------
# Leave the password blank to be prompted for it instead of storing it here.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=ShriDev Admin
