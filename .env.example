# =============================================================================
# ShriDev — environment configuration
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit a completed .env.
#
#   cp .env.example .env
#
# Frontend (NEXT_PUBLIC_*) values are inlined into the browser bundle at build
# time and are therefore PUBLIC. Never put a secret behind a NEXT_PUBLIC_ name.
# =============================================================================


# -----------------------------------------------------------------------------
# Backend — database
# -----------------------------------------------------------------------------
# Managed providers supply this. `postgres://` and `postgresql://` are both
# accepted and normalised to the psycopg 3 driver automatically.
DATABASE_URL=postgresql+psycopg://shridev:ShriDev@123@127.0.0.1:5432/shridev

# Used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://shridev:ShriDev@123@127.0.0.1:5432/shridev_test


# -----------------------------------------------------------------------------
# Backend — security
# -----------------------------------------------------------------------------
# Signs admin access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it immediately invalidates every issued token.
# REQUIRED when ENVIRONMENT=production — the app refuses to start without it.
SECRET_KEY=Y1WmIOvGbqcMqFth174py3Tsb9_m_htNuSwyv-1yqQNrWIVvZmslZkq3gJx8hmky

# development | staging | production
# In production the app additionally refuses a localhost DATABASE_URL or a
# localhost CORS origin, and disables /docs, /redoc and /openapi.json.
ENVIRONMENT=development
DEBUG=false

ACCESS_TOKEN_EXPIRE_MINUTES=480
# bcrypt work factor. Raise as hardware improves; each +1 doubles hashing cost.
BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
# Backend — CORS
# -----------------------------------------------------------------------------
# Comma-separated exact origins allowed to call the API. Never "*": admin
# requests carry credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# -----------------------------------------------------------------------------
# Backend — rate limiting
# -----------------------------------------------------------------------------
# In-process counters. With multiple workers the effective limit is per
# process — see docs/deployment.md before scaling horizontally.
RATE_LIMIT_ENABLED=true
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=900


# -----------------------------------------------------------------------------
# Backend — first admin account (used only by scripts/create_admin.py)
# -----------------------------------------------------------------------------
# Leave the password blank to be prompted for it instead of storing it here.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=ShriDev Admin


# -----------------------------------------------------------------------------
# Frontend — API connection
# -----------------------------------------------------------------------------
# Server-side base URL. Used by React Server Components and route handlers.
# Kept non-public so the browser never talks to the API directly.
API_URL=http://127.0.0.1:8000

# Public canonical site URL. Used for canonical tags, OpenGraph and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Frontend — admin session cookie
# -----------------------------------------------------------------------------
# Name of the HttpOnly cookie holding the admin token. Change only if it
# collides with something else on the same domain.
ADMIN_SESSION_COOKIE=shridev_admin_session


# -----------------------------------------------------------------------------
# Frontend — business details (PUBLIC)
# -----------------------------------------------------------------------------
# Leave any of these blank and the corresponding UI is omitted entirely rather
# than rendering a placeholder that reads as real business information.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only, international format, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Free-text locality, e.g. "Pune, Maharashtra, India"
NEXT_PUBLIC_LOCATION=

# Registered entity details, used by Organization structured data.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_FOUNDING_YEAR=


# -----------------------------------------------------------------------------
# Frontend — social profiles (PUBLIC)
# -----------------------------------------------------------------------------
# Full URLs. Blank entries are not rendered.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=


# -----------------------------------------------------------------------------
# Frontend — analytics (PUBLIC, all optional)
# -----------------------------------------------------------------------------
# Nothing loads unless the ID is set, so local and preview builds stay
# untracked. Never commit a real ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
